{
  "name": "anker-linkedin-ext",
  "version": "0.1.0",
  "description": "Anker LinkedIn extension: capture profile HTML into the Anker CRM and assist drafting outreach DMs.",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@plasmohq/messaging": "^0.7.0",
    "@plasmohq/storage": "^1.13.0",
    "plasmo": "^0.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.290",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "postcss": "^8.5.0",
    "typescript": "^5.5.0"
  },
  "manifest": {
    "name": "Anker LinkedIn",
    "short_name": "Anker",
    "description": "One-click LinkedIn to CRM. Sync connections, get a Network graph, and use pre-drafted DMs from your Anker workspace.",
    "author": "Anker",
    "homepage_url": "https://anker.de",
    "host_permissions": [
      "https://www.linkedin.com/*",
      "https://*.linkedin.com/*"
    ],
    "permissions": [
      "storage",
      "tabs",
      "scripting",
      "activeTab"
    ],
    "icons": {
      "16":  "assets/icon.png",
      "32":  "assets/icon.png",
      "48":  "assets/icon.png",
      "128": "assets/icon.png"
    },
    "action": {
      "default_title": "Anker LinkedIn",
      "default_icon": {
        "16":  "assets/icon.png",
        "32":  "assets/icon.png",
        "48":  "assets/icon.png",
        "128": "assets/icon.png"
      }
    }
  }
}
