{
  "name": "Anker — Connect then Message (example)",
  "meta": {
    "description": "Illustrative LinkedIn sequence driven from n8n against Anker's orchestration API. Enqueue a connect request, wait, check whether it sent, and (if so) enqueue a follow-up message. Both actions land in Anker's approval queue by default — a human approves before the extension executes. Set the Config node's values to real ones and attach the 'Anker Orchestration' Header Auth credential to both HTTP nodes before running."
  },
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Manual / Schedule Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [220, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "baseUrl", "type": "string", "value": "https://www.an-ker.de" },
            { "id": "a2", "name": "userId", "type": "string", "value": "REPLACE_WITH_ANKER_USER_ID" },
            { "id": "a3", "name": "senderId", "type": "string", "value": "REPLACE_WITH_SENDER_ID" },
            { "id": "a4", "name": "targetUrl", "type": "string", "value": "https://www.linkedin.com/in/example/" },
            { "id": "a5", "name": "targetName", "type": "string", "value": "Example Person" },
            { "id": "a6", "name": "campaignId", "type": "string", "value": "example-campaign" }
          ]
        },
        "options": {}
      },
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.baseUrl }}/api/orchestration/actions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ userId: $json.userId, senderId: $json.senderId, campaignId: $json.campaignId, actionType: 'connect_request', targetUrl: $json.targetUrl, targetName: $json.targetName, payload: { message: 'Hi ' + $json.targetName.split(' ')[0] + \" — I'd love to connect.\" } }) }}",
        "options": {}
      },
      "id": "enqueue-connect",
      "name": "Enqueue connect",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "days"
      },
      "id": "wait",
      "name": "Wait for send + approval",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [880, 300],
      "webhookId": "anker-wait-example"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').item.json.baseUrl }}/api/orchestration/actions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "userId", "value": "={{ $('Config').item.json.userId }}" },
            { "name": "campaignId", "value": "={{ $('Config').item.json.campaignId }}" },
            { "name": "status", "value": "done" }
          ]
        },
        "options": {}
      },
      "id": "check-state",
      "name": "Check connect state",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.actions.filter(a => a.actionType === 'connect_request').length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-sent",
      "name": "Connect sent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1320, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.baseUrl }}/api/orchestration/actions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ userId: $('Config').item.json.userId, senderId: $('Config').item.json.senderId, campaignId: $('Config').item.json.campaignId, actionType: 'message', targetUrl: $('Config').item.json.targetUrl, targetName: $('Config').item.json.targetName, payload: { message: 'Thanks for connecting, ' + $('Config').item.json.targetName.split(' ')[0] + '!' } }) }}",
        "options": {}
      },
      "id": "enqueue-message",
      "name": "Enqueue follow-up message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 220]
    }
  ],
  "connections": {
    "Manual / Schedule Trigger": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config": { "main": [[{ "node": "Enqueue connect", "type": "main", "index": 0 }]] },
    "Enqueue connect": { "main": [[{ "node": "Wait for send + approval", "type": "main", "index": 0 }]] },
    "Wait for send + approval": { "main": [[{ "node": "Check connect state", "type": "main", "index": 0 }]] },
    "Check connect state": { "main": [[{ "node": "Connect sent?", "type": "main", "index": 0 }]] },
    "Connect sent?": { "main": [[{ "node": "Enqueue follow-up message", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1" }
}
