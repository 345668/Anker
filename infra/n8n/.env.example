# ─── n8n on Railway, backed by Neon Postgres (schema: n8n) ───────────────────
# Copy these into the Railway service's Variables. Values shown are placeholders.
# See ./README.md for the full walkthrough.

# ── Database (Neon, DIRECT/unpooled host — not the -pooler host) ──────────────
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=ep-xxxx.eu-central-1.aws.neon.tech
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=neondb
DB_POSTGRESDB_USER=neondb_owner
DB_POSTGRESDB_PASSWORD=__neon_password__
DB_POSTGRESDB_SCHEMA=n8n
DB_POSTGRESDB_SSL_ENABLED=true

# ── Encryption (encrypts stored credentials at rest) ─────────────────────────
# Generate once: openssl rand -hex 24   —   NEVER change after first deploy.
N8N_ENCRYPTION_KEY=__stable_32char+_secret__

# ── Networking (Railway assigns PORT; n8n must listen on it) ──────────────────
N8N_PORT=${{PORT}}
N8N_PROTOCOL=https
N8N_HOST=your-n8n.up.railway.app
WEBHOOK_URL=https://your-n8n.up.railway.app/

# ── Misc ─────────────────────────────────────────────────────────────────────
GENERIC_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin
# Recommended hardening on current n8n:
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336   # prune execution logs older than 14 days (hours)

# ─── NOTE: these are n8n's OWN env vars. The Anker-side key lives on Vercel: ──
#   ORCHESTRATION_API_KEY=<openssl rand -hex 32>
# n8n presents it as an "Anker Orchestration" Header Auth credential:
#   Authorization: Bearer <ORCHESTRATION_API_KEY>
